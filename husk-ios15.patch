diff --git a/src/app/Husk/Localization.swift b/src/app/Husk/Localization.swift
new file mode 100644
index 0000000..0f9e434
--- /dev/null
+++ b/src/app/Husk/Localization.swift
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+import Foundation
+
+/// UI language is explicit for this fork; protocol tokens and exported logs
+/// remain unchanged so a report can still be compared with upstream.
+func L(_ key: String) -> String {
+    let language = UserDefaults.standard.string(forKey: "husk.language") ?? "ru"
+    guard let path = Bundle.main.path(forResource: language == "en" ? "en" : "ru", ofType: "lproj"),
+          let bundle = Bundle(path: path) else { return key }
+    return bundle.localizedString(forKey: key, value: key, table: nil)
+}
