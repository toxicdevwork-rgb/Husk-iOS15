@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+"""Fail packaging if Android runtime data is missing, corrupt or stripped of DEX."""
+from pathlib import Path
+import sys
+import zipfile
+
+JARS = [f'com.android.art/javalib/{n}.jar' for n in
+        ('core-oj', 'core-libart', 'okhttp', 'bouncycastle', 'apache-xml')] + [
+    'com.android.i18n/javalib/core-icu4j.jar', 'com.android.conscrypt/javalib/conscrypt.jar',
+    'org.apache.http.legacy.jar']
+LIBS = [f'com.android.art/lib64/{n}.so' for n in
+        ('libandroidio', 'libbase', 'libc++', 'libexpat', 'libjavacore', 'libnativehelper', 'libopenjdk')] + [
+    f'com.android.conscrypt/lib64/{n}.so' for n in ('libjavacrypto', 'libcrypto', 'libssl')]
+
+
+def audit(root):
+    errors = []
+    runtime = root/'java-runtime'
+    for relative in JARS:
+        try:
+            with zipfile.ZipFile(runtime/relative) as z:
+                data = z.read('classes.dex')
+                if not data.startswith(b'dex\n') or len(data) < 112:
+                    raise ValueError('invalid classes.dex')
+                if z.testzip() is not None:
+                    raise ValueError('invalid ZIP CRC')
+        except (OSError, KeyError, ValueError, zipfile.BadZipFile) as e:
+            errors.append(f'{relative}: {e}')
+    for relative in LIBS:
+        try:
+            with (runtime/relative).open('rb') as f:
+                h = f.read(20)
+            if len(h) < 20 or h[:5] != b'\x7fELF\x02' or h[18:20] != b'\xb7\x00':
+                raise ValueError('expected arm64 ELF library')
+        except (OSError, ValueError) as e:
+            errors.append(f'{relative}: {e}')
+    try:
+        data = (runtime/'husk-framework.dex').read_bytes()
+        if len(data) < 112 or not data.startswith(b'dex\n'):
+            raise ValueError('invalid Husk framework DEX')
+        with zipfile.ZipFile(runtime/'framework-res.apk') as z:
+            if not z.read('resources.arsc'):
+                raise ValueError('empty Android resource table')
+    except (OSError, KeyError, ValueError, zipfile.BadZipFile) as e:
+        errors.append(str(e))
+    for folder, pattern in [('java-runtime/com.android.i18n/etc/icu', '*.dat'),
+                            ('java-runtime/com.android.tzdata/etc', 'tzdata'),
+                            ('android-system/fonts', '*.ttf'), ('android-system/cacerts', '*'),
+                            ('android-system/etc', 'fonts.xml')]:
+        if not any(p.is_file() and p.stat().st_size > 0 for p in (root/folder).glob(pattern)):
+            errors.append(f'missing/empty {folder}/{pattern}')
+    return errors
+
+
+if __name__ == '__main__':
+    problems = audit(Path(sys.argv[1]))
+    print('\n'.join(problems) if problems else 'Android runtime resources: OK')
+    sys.exit(bool(problems))
