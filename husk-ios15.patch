diff --git a/src/app/Husk/RuntimeSession.swift b/src/app/Husk/RuntimeSession.swift
new file mode 100644
index 0000000..7b67767
--- /dev/null
+++ b/src/app/Husk/RuntimeSession.swift
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+import Foundation
+
+/// QEMU and the native loader share the prewarmed executable mapping. Once
+/// either has claimed it, the other must wait for a new process, not overwrite it.
+enum RuntimeSession {
+    enum Engine { case android, translation }
+    private static let lock = NSLock()
+    private static var owner: Engine?
+    private(set) static var translationError: String?
+
+    static func claim(_ engine: Engine) -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        if let owner, owner != engine { return false }
+        owner = engine
+        return true
+    }
+
+    static func failTranslation(_ message: String) {
+        translationError = message
+        HuskLog.log("tl", "launch blocked: \(message)")
+    }
+
+    static var switchMessage: String {
+        L("Restart Husk to switch between Android and Translation Layer. Disable Start Android on launch before opening a translated app.")
+    }
+}
