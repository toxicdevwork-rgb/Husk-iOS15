diff --git a/tests/test_ios15_bundle.py b/tests/test_ios15_bundle.py
new file mode 100644
index 0000000..20d4f74
--- /dev/null
+++ b/tests/test_ios15_bundle.py
@@ -0,0 +1,76 @@
+import plistlib
+import struct
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
+from audit_ios15_bundle import audit
+
+
+def macho(minos=0x0F0600, platform=2, cpu=0x100000C, library=None, weak=False):
+    commands = struct.pack("<6I", 0x32, 24, platform, minos, 0x1A0000, 0)
+    count = 1
+    if library:
+        name = library.encode() + b"\0"
+        size = (24 + len(name) + 7) & ~7
+        commands += struct.pack("<6I", 0x80000018 if weak else 0xC, size, 24, 0, 0, 0)
+        commands += name.ljust(size - 24, b"\0")
+        count += 1
+    return struct.pack("<8I", 0xFEEDFACF, cpu, 0, 2, count, len(commands), 0, 0) + commands
+
+
+class BundleCompatibilityTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.app = Path(self.temp.name) / "Husk.app"
+        self.app.mkdir()
+        (self.app / "Info.plist").write_bytes(plistlib.dumps({
+            "CFBundleExecutable": "Husk", "MinimumOSVersion": "15.6"}))
+        (self.app / "Husk").write_bytes(macho())
+
+    def test_modern_sdk_is_allowed_with_old_deployment_target(self):
+        self.assertEqual(audit(self.app), [])
+
+    def test_embedded_dylib_cannot_require_ios16(self):
+        (self.app / "new.dylib").write_bytes(macho(minos=0x100000))
+        self.assertTrue(any("new.dylib" in e for e in audit(self.app)))
+
+    def test_simulator_arm64_is_not_a_device_binary(self):
+        (self.app / "Husk").write_bytes(macho(platform=7))
+        self.assertTrue(any("platform/minOS" in e for e in audit(self.app)))
+
+    def test_x86_is_not_arm64(self):
+        (self.app / "Husk").write_bytes(macho(cpu=0x1000007))
+        self.assertTrue(any("arm64" in e for e in audit(self.app)))
+
+    def test_stale_extensions_fail_even_without_code(self):
+        (self.app / "PlugIns/HuskJITHelper.appex").mkdir(parents=True)
+        self.assertTrue(any("unsupported component" in e for e in audit(self.app)))
+
+    def test_new_framework_must_be_weak_linked(self):
+        path = "/System/Library/Frameworks/ActivityKit.framework/ActivityKit"
+        (self.app / "Husk").write_bytes(macho(library=path))
+        self.assertTrue(any("strong link" in e for e in audit(self.app)))
+        (self.app / "Husk").write_bytes(macho(library=path, weak=True))
+        self.assertEqual(audit(self.app), [])
+
+    def test_truncated_macho_fails(self):
+        (self.app / "Husk").write_bytes(macho()[:35])
+        self.assertTrue(any("malformed" in e for e in audit(self.app)))
+
+    def test_framework_plist_cannot_require_newer_os(self):
+        framework = self.app / "Frameworks/New.framework"
+        framework.mkdir(parents=True)
+        (framework / "Info.plist").write_bytes(plistlib.dumps({"MinimumOSVersion": "16.0"}))
+        self.assertTrue(any("New.framework" in e for e in audit(self.app)))
+
+    def test_missing_main_executable_fails(self):
+        (self.app / "Husk").unlink()
+        self.assertTrue(any("main executable missing" in e for e in audit(self.app)))
+
+
+if __name__ == "__main__":
+    unittest.main()
