@@ -0,0 +1,38 @@
+name: Build Husk for iOS 15.6
+on:
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  build:
+    runs-on: macos-latest
+    timeout-minutes: 360
+    env:
+      SDKMINVER: "15.6"
+      DD: /tmp/husk_ios15
+    steps:
+      - uses: actions/checkout@v4
+      - name: Install build tools
+        run: |
+          brew install meson ninja pkg-config xcodegen qemu
+          python3 -m venv /tmp/husk-build-python
+          /tmp/husk-build-python/bin/python -m pip install 'PyYAML==6.0.3' 'Mako==1.3.10'
+          echo /tmp/husk-build-python/bin >> "$GITHUB_PATH"
+          rustup target add aarch64-apple-ios
+          xcodebuild -version
+          xcrun --sdk iphoneos --show-sdk-version
+      - name: Test bundle compatibility gate
+        run: python3 -m unittest discover -s tests -p 'test_ios15_*.py' -v
+      - name: Build dependencies and packages from source
+        run: ./scripts/ci_build.sh "$PWD/build/Husk-iOS15.ipa"
+      - name: Preserve packages and build diagnostics
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: Husk-iOS15-build
+          if-no-files-found: warn
+          path: |
+            build/*.ipa
+            build/*.tipa
+            build/logs/
+            /tmp/husk_ios15/build.log
