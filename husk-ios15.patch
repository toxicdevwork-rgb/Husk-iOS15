index 0000000..44a8b81
--- /dev/null
+++ b/scripts/macho_reader.py
@@ -0,0 +1,122 @@
+"""Bounds-checked Mach-O load command reader (Python standard library only)."""
+import struct
+
+THIN = {
+    b"\xcf\xfa\xed\xfe": ("<", True),
+    b"\xfe\xed\xfa\xcf": (">", True),
+    b"\xce\xfa\xed\xfe": ("<", False),
+    b"\xfe\xed\xfa\xce": (">", False),
+}
+FAT = {
+    b"\xca\xfe\xba\xbe": (">", False),
+    b"\xbe\xba\xfe\xca": ("<", False),
+    b"\xca\xfe\xba\xbf": (">", True),
+    b"\xbf\xba\xfe\xca": ("<", True),
+}
+DYLIB_COMMANDS = {0xC: "required", 0x80000018: "weak", 0x8000001F: "reexport", 0x80000023: "upward", 0x20: "lazy"}
+LIMIT = 1024 * 1024 * 1024
+
+
+def version(value):
+    return f"{value >> 16}.{(value >> 8) & 255}.{value & 255}"
+
+
+def os_tuple(value):
+    parts = tuple(int(part) for part in value.split("."))
+    if not 1 <= len(parts) <= 3 or any(part < 0 for part in parts):
+        raise ValueError("Invalid OS version")
+    return parts + (0,) * (3 - len(parts))
+
+
+def parse_macho(data):
+    data = bytes(data)
+    magic = data[:4]
+    if magic in FAT:
+        endian, wide = FAT[magic]
+        if len(data) < 8:
+            raise ValueError("Truncated fat header")
+        count = struct.unpack_from(endian + "I", data, 4)[0]
+        stride = 32 if wide else 20
+        table_end = 8 + count * stride
+        if not 1 <= count <= 16 or table_end > len(data):
+            raise ValueError("Invalid fat architecture table")
+        slices, ranges = [], []
+        for i in range(count):
+            fields = struct.unpack_from(endian + ("IIQQII" if wide else "IIIII"), data, 8 + i * stride)
+            offset, size = fields[2:4]
+            if offset < table_end or size < 28 or offset + size > len(data):
+                raise ValueError("Invalid fat slice bounds")
+            if any(offset < end and start < offset + size for start, end in ranges):
+                raise ValueError("Overlapping fat slices")
+            ranges.append((offset, offset + size))
+            if data[offset:offset + 4] not in THIN:
+                raise ValueError("Invalid Mach-O slice")
+            parsed = parse_macho(data[offset:offset + size])[0]
+            if parsed["cpu_type"] != fields[0] or parsed["cpu_subtype"] != fields[1]:
+                raise ValueError("Fat table and slice architecture disagree")
+            slices.append(parsed)
+        return slices
+    if magic not in THIN:
+        raise ValueError("Not a Mach-O binary")
+    endian, wide = THIN[magic]
+    header_size = 32 if wide else 28
+    if len(data) < header_size:
+        raise ValueError("Truncated Mach-O header")
+    fields = struct.unpack_from(endian + ("8I" if wide else "7I"), data)
+    cpu, subtype, filetype, count, command_bytes = fields[1:6]
+    commands_end = header_size + command_bytes
+    if count > command_bytes // 8 or commands_end > len(data):
+        raise ValueError("Invalid Mach-O load command table")
+    result = {
+        "cpu_type": cpu, "cpu_subtype": subtype,
+        "architecture": {0x100000C: "arm64", 12: "arm", 0x1000007: "x86_64", 7: "x86"}.get(cpu, hex(cpu)),
+        "file_type": filetype, "build_versions": [], "encryption": [], "libraries": [], "rpaths": [],
+    }
+    offset = header_size
+    for _ in range(count):
+        if offset + 8 > commands_end:
+            raise ValueError("Truncated load command")
+        command, size = struct.unpack_from(endian + "II", data, offset)
+        if size < 8 or size % 4 or offset + size > commands_end:
+            raise ValueError("Invalid load command bounds")
+
+        def require(minimum):
+            if size < minimum:
+                raise ValueError("Truncated load command payload")
+
+        def string_at(relative):
+            if not 8 <= relative < size:
+                raise ValueError("Invalid load command string offset")
+            end = data.find(b"\0", offset + relative, offset + size)
+            if end == -1:
+                raise ValueError("Unterminated load command string")
+            return data[offset + relative:end].decode("utf-8", "replace")
+
+        if command == 0x32:
+            require(24)
+            platform, minimum, sdk, tools = struct.unpack_from(endian + "4I", data, offset + 8)
+            if 24 + tools * 8 > size:
+                raise ValueError("Truncated build tool table")
+            result["build_versions"].append({"platform": platform, "minimum_os": version(minimum), "sdk": version(sdk)})
+        elif command in {0x24, 0x25, 0x2F, 0x30}:
+            require(16)
+            minimum, sdk = struct.unpack_from(endian + "II", data, offset + 8)
+            result["build_versions"].append({"platform": {0x24: 1, 0x25: 2, 0x2F: 3, 0x30: 4}[command], "minimum_os": version(minimum), "sdk": version(sdk)})
+        elif command in {0x21, 0x2C}:
+            require(24 if command == 0x2C else 20)
+            start, length, cryptid = struct.unpack_from(endian + "3I", data, offset + 8)
+            if start + length > len(data):
+                raise ValueError("Invalid encrypted region bounds")
+            result["encryption"].append({"cryptid": cryptid, "offset": start, "size": length})
+        elif command in DYLIB_COMMANDS:
+            require(24)
+            relative = struct.unpack_from(endian + "I", data, offset + 8)[0]
+            result["libraries"].append({"path": string_at(relative), "linkage": DYLIB_COMMANDS[command]})
+        elif command == 0x8000001C:
+            require(12)
+            relative = struct.unpack_from(endian + "I", data, offset + 8)[0]
+            result["rpaths"].append(string_at(relative))
+        offset += size
+    if offset != commands_end:
+        raise ValueError("Load command size/count mismatch")
+    return [result]
