diff --git a/scripts/prepare_android_runtime.py b/scripts/prepare_android_runtime.py
new file mode 100644
index 0000000..33ab468
--- /dev/null
+++ b/scripts/prepare_android_runtime.py
@@ -0,0 +1,178 @@
+#!/usr/bin/env python3
+"""Extract the translation runtime from Husk's pinned Lineage image on CI.
+
+Requires qemu-img and e2fsprogs debugfs. No mounted image or developer-local
+Android checkout is needed. All downloads are verified before extraction.
+"""
+import hashlib
+import io
+import json
+import os
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import tempfile
+import urllib.request
+import zipfile
+
+ROOT = Path(__file__).resolve().parents[1]
+IMAGE_URL = 'https://github.com/Leviidev/Husk/releases/download/lineage-v2/vda-v12.qcow2'
+IMAGE_SHA = 'a8dbaecc8fdcd682991b078d6bbb7df6972e459208634fa8dcbad24f17208d6a'
+R8_URL = 'https://storage.googleapis.com/r8-releases/raw/8.5.35/r8.jar'
+R8_SHA = 'cb112407ef132dfcb1e5e1a9d4e6fefa89807822e65a9ffbdbb68ee442985405'
+
+
+def download(url, dest, expected):
+    print('Downloading', url, flush=True)
+    subprocess.run(['curl', '-fL', '--retry', '4', '--output', str(dest), url], check=True)
+    with dest.open('rb') as f:
+        digest = hashlib.file_digest(f, 'sha256').hexdigest()
+    if digest != expected:
+        dest.unlink()
+        raise ValueError(f'Checksum mismatch for {url}: {digest}')
+
+
+def read_exact(f, count):
+    data = f.read(count)
+    if len(data) != count:
+        raise ValueError('Truncated disk/partition metadata')
+    return data
+
+
+def extract_system(raw, out):
+    """Read GPT and Android logical-partition metadata without macOS gpt."""
+    with raw.open('rb') as f:
+        f.seek(512)
+        header = read_exact(f, 92)
+        if header[:8] != b'EFI PART':
+            raise ValueError('Expected a GPT disk')
+        entries_lba, count, stride = struct.unpack_from('<QII', header, 72)
+        if not 128 <= stride <= 4096 or not 2 <= count <= 4096:
+            raise ValueError('Invalid GPT entries')
+        f.seek(entries_lba * 512)
+        entries = read_exact(f, count * stride)
+        # This guest puts super in GPT partition 2 (as upstream's extractor does).
+        base = struct.unpack_from('<Q', entries, stride + 32)[0] * 512
+        f.seek(base + 12288)
+        h = read_exact(f, 256)
+        magic, _, _, hsize = struct.unpack_from('<IHHI', h)
+        tsize = struct.unpack_from('<I', h, 44)[0]
+        if magic != 0x414C5030 or not 128 <= hsize <= 4096 or tsize > 16 << 20:
+            raise ValueError('Invalid Android logical partition metadata')
+        (po, pn, ps), (eo, en, es) = [struct.unpack_from('<III', h, 80 + 12*i) for i in range(2)]
+        f.seek(base + 12288 + hsize)
+        table = read_exact(f, tsize)
+        if ps < 52 or es < 24 or po + pn*ps > tsize or eo + en*es > tsize:
+            raise ValueError('Invalid logical partition table bounds')
+        for i in range(pn):
+            entry = table[po+i*ps:po+(i+1)*ps]
+            name = entry[:36].split(b'\0')[0]
+            if name not in (b'system', b'system_a'):
+                continue
+            _, first, n, _ = struct.unpack_from('<IIII', entry, 36)
+            if first + n > en:
+                raise ValueError('Invalid extent index')
+            with out.open('wb') as w:
+                for j in range(first, first+n):
+                    sectors, kind, sector, device = struct.unpack_from('<QIQI', table, eo+j*es)
+                    left = sectors * 512
+                    if kind == 1:  # zero extent; keep the output sparse
+                        w.seek(left, 1)
+                        continue
+                    if kind != 0 or device != 0:
+                        raise ValueError('Unsupported logical partition extent')
+                    f.seek(base + sector*512)
+                    while left:
+                        data = read_exact(f, min(left, 8 << 20))
+                        w.write(data)
+                        left -= len(data)
+                w.truncate()
+            return
+        raise ValueError('System partition missing')
+
+
+def main():
+    source = ROOT / 'build/android-source'
+    stamp = source / 'source.sha256'
+    debugfs = shutil.which('debugfs')
+    if not debugfs:
+        prefix = subprocess.check_output(['brew', '--prefix', 'e2fsprogs'], text=True).strip()
+        debugfs = str(Path(prefix) / 'sbin/debugfs')
+
+    def dump(image, path, dest, directory=False):
+        # debugfs may exit 0 on a missing file: validate the actual output.
+        subprocess.run([debugfs, '-R', f'{"rdump" if directory else "dump"} {path} {dest}', str(image)], check=True)
+        result = dest / Path(path).name if directory else dest
+        if not result.exists() or (result.is_file() and result.stat().st_size == 0):
+            raise ValueError(f'Missing required Android resource: {path}')
+        return result
+
+    if not stamp.exists() or stamp.read_text().strip() != IMAGE_SHA:
+        with tempfile.TemporaryDirectory(prefix='husk-android-') as tmp:
+            work = Path(tmp)
+            download(IMAGE_URL, work / 'vda.qcow2', IMAGE_SHA)
+            subprocess.run(['qemu-img', 'convert', '-O', 'raw', str(work/'vda.qcow2'), str(work/'vda.raw')], check=True)
+            extract_system(work/'vda.raw', work/'system.img')
+            if source.exists():
+                shutil.rmtree(source)
+            (source/'apex').mkdir(parents=True)
+            (source/'framework').mkdir()
+            system = work/'system.img'
+            # Keep only the four APEX packages that the runtime consumes.
+            apex_dir = work/'apex-files'
+            apex_dir.mkdir()
+            listing = subprocess.check_output([debugfs, '-R', 'ls -p /system/apex', str(system)], text=True)
+            for module in ('art', 'i18n', 'conscrypt', 'tzdata'):
+                name = 'com.android.' + module
+                filename = next((name+ext for ext in ('.capex', '.apex') if '/'+name+ext+'/' in listing), None)
+                if filename is None:
+                    raise ValueError(f'{name} is absent from the Lineage image')
+                package = dump(system, '/system/apex/'+filename, apex_dir/filename)
+                with zipfile.ZipFile(package) as z:
+                    if 'original_apex' in z.namelist():
+                        with zipfile.ZipFile(io.BytesIO(z.read('original_apex'))) as original:
+                            payload = original.read('apex_payload.img')
+                    else:
+                        payload = z.read('apex_payload.img')
+                img = work/(name+'.img')
+                img.write_bytes(payload)
+                dest = source/'apex'/name
+                dest.mkdir()
+                for folder in {'art': ['javalib', 'lib64'], 'i18n': ['javalib', 'lib64', 'etc'],
+                               'conscrypt': ['javalib', 'lib64', 'cacerts'], 'tzdata': ['etc']}[module]:
+                    dump(img, '/'+folder, dest, directory=True)
+            for filename in ('org.apache.http.legacy.jar', 'framework-res.apk'):
+                dump(system, '/system/framework/'+filename, source/'framework'/filename)
+            android = source/'android-system'
+            (android/'etc').mkdir(parents=True)
+            dump(system, '/system/fonts', android, directory=True)
+            for f in (android/'fonts').glob('*CJK*'):
+                f.unlink()
+            for filename in ('fonts.xml', 'font_fallback.xml'):
+                dump(system, '/system/etc/'+filename, android/'etc'/filename)
+            shutil.copytree(source/'apex/com.android.conscrypt/cacerts', android/'cacerts')
+            stamp.write_text(IMAGE_SHA+'\n')
+
+    r8 = ROOT/'build/r8-8.5.35.jar'
+    if not r8.exists() or hashlib.sha256(r8.read_bytes()).hexdigest() != R8_SHA:
+        download(R8_URL, r8, R8_SHA)
+    env = dict(os.environ, HUSK_D8=str(r8),
+               HTTP_LEGACY=str(source/'framework/org.apache.http.legacy.jar'),
+               FRAMEWORK_RES=str(source/'framework/framework-res.apk'))
+    subprocess.run(['bash', str(ROOT/'scripts/build_java_runtime.sh'), str(source/'apex')], env=env, check=True)
+    android_out = ROOT/'build/android-system'
+    if android_out.exists():
+        shutil.rmtree(android_out)
+    shutil.copytree(source/'android-system', android_out)
+    from audit_runtime_resources import audit
+    errors = audit(ROOT/'build')
+    if errors:
+        raise ValueError('\n'.join(errors))
+    (ROOT/'build/java-runtime/provenance.json').write_text(json.dumps({
+        'image': IMAGE_URL, 'sha256': IMAGE_SHA, 'd8': R8_URL, 'd8_sha256': R8_SHA}, indent=2)+'\n')
+    print('Android translation runtime validated', flush=True)
+
+
+if __name__ == '__main__':
+    main()
