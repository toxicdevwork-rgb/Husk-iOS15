diff --git a/src/app/Husk/IOS15Compatibility.swift b/src/app/Husk/IOS15Compatibility.swift
new file mode 100644
index 0000000..cc146ab
--- /dev/null
+++ b/src/app/Husk/IOS15Compatibility.swift
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+import SwiftUI
+
+extension Color {
+    var huskGradient: LinearGradient {
+        LinearGradient(colors: [opacity(0.75), self],
+                       startPoint: .top, endPoint: .bottom)
+    }
+}
+
+/// The label/value rows used by Husk, without requiring iOS 16 LabeledContent.
+struct HuskLabeledContent<Label: View, Content: View>: View {
+    private let label: Label
+    private let content: Content
+
+    init(@ViewBuilder content: () -> Content, @ViewBuilder label: () -> Label) {
+        self.label = label()
+        self.content = content()
+    }
+
+    var body: some View {
+        HStack(alignment: .firstTextBaseline) {
+            label
+            Spacer(minLength: 12)
+            content.foregroundStyle(.secondary).multilineTextAlignment(.trailing)
+        }
+    }
+}
+
+extension HuskLabeledContent where Label == Text {
+    init(_ title: String, @ViewBuilder content: () -> Content) {
+        self.init(content: content, label: { Text(title) })
+    }
+}
+
+extension HuskLabeledContent where Label == Text, Content == Text {
+    init(_ title: String, value: String) {
+        self.init(content: { Text(value) }, label: { Text(title) })
+    }
+}
+
+/// All current share links export report files. Reuse the app's UIKit sheet.
+struct HuskShareLink<Label: View>: View {
+    let item: URL
+    private let label: Label
+    @State private var sharing = false
+
+    init(item: URL, @ViewBuilder label: () -> Label) {
+        self.item = item
+        self.label = label()
+    }
+
+    var body: some View {
+        Button { sharing = true } label: { label }
+            .sheet(isPresented: $sharing) { ShareSheet(items: [item]) }
+    }
+}
+
+enum HuskSheetDetent: Hashable {
+    case medium
+    case height(CGFloat)
+
+    @available(iOS 16.0, *)
+    var native: PresentationDetent {
+        switch self {
+        case .medium: return .medium
+        case .height(let value): return .height(value)
+        }
+    }
+}
+
+extension View {
+    @ViewBuilder func huskHideSystemOverlays() -> some View {
+        if #available(iOS 16.0, *) {
+            persistentSystemOverlays(.hidden)
+        } else {
+            self
+        }
+    }
+
+    @ViewBuilder func huskDeferSystemGestures() -> some View {
+        if #available(iOS 16.0, *) {
+            defersSystemGestures(on: .all)
+        } else {
+            self
+        }
+    }
+
+    @ViewBuilder func huskDismissKeyboardOnScroll() -> some View {
+        if #available(iOS 16.0, *) {
+            scrollDismissesKeyboard(.immediately)
+        } else {
+            simultaneousGesture(DragGesture().onChanged { _ in
+                UIApplication.shared.sendAction(#selector(UIResponder.resignFirstResponder),
+                                                 to: nil, from: nil, for: nil)
+            })
+        }
+    }
+
+    /// iOS 15 keeps its standard sheet, including swipe-to-dismiss. Later
+    /// systems retain the upstream compact heights.
+    @ViewBuilder func huskPresentationDetents(_ detents: Set<HuskSheetDetent>) -> some View {
+        if #available(iOS 16.0, *) {
+            presentationDetents(Set(detents.map(\.native)))
+        } else {
+            self
+        }
+    }
+
+    @ViewBuilder func huskPresentationDragIndicator() -> some View {
+        if #available(iOS 16.0, *) {
+            presentationDragIndicator(.visible)
+        } else {
+            self
+        }
+    }
+
+    @ViewBuilder func huskHideScrollIndicators() -> some View {
+        if #available(iOS 16.0, *) {
+            scrollIndicators(.hidden)
+        } else {
+            self
+        }
+    }
+}
+
+extension Animation {
+    static var huskSnappy: Animation { huskSnappy(duration: 0.5) }
+
+    static func huskSnappy(duration: Double) -> Animation {
+        if #available(iOS 17.0, *) {
+            return .snappy(duration: duration)
+        }
+        return .spring(response: duration, dampingFraction: 0.85)
+    }
+}
